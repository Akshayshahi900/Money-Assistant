# The app works with NO key: all six scenarios route through rules. A key only adds LLM routing for unusual phrasings (one is enough):
GEMINI_API_KEY=
GROQ_API_KEY=
# Default Groq model (openai/gpt-oss-20b) published token rates; update if you change provider/model.
LLM_INPUT_USD_PER_1M_TOKENS=0.075
LLM_OUTPUT_USD_PER_1M_TOKENS=0.30
# Fixed "today" so evaluation is reproducible (latest transaction is 2026-11-22)
CURRENT_DATE=2026-11-23
